    }\r\n                ],\r\n    \"synonyms\":  [\r\n                     \"code\",\r\n                    
    \"HLSL\"\r\n                 ],\r\n    \"m_Precision\":  0,\r\n    \"m_PreviewExpanded\": 
    false,\r\n    \"m_DismissedVersion\":  0,\r\n    \"m_PreviewMode\":  0,\r\n   
    \"m_CustomColors\":  {\r\n                           \"m_SerializableColors\": 
    [\r\n\r\n                                                    ]\r\n                      
    },\r\n    \"m_SourceType\":  1,\r\n    \"m_FunctionName\":  \"SnowPostProcessGraph\",\r\n   
    \"m_FunctionSource\":  \"\",\r\n    \"m_FunctionBody\":  \"float2 uv = saturate(ScreenPosition.xy);\\nfloat3
    sceneColor = SHADERGRAPH_SAMPLE_SCENE_COLOR(uv).rgb;\\nfloat3 normalWS = normalize(SHADERGRAPH_SAMPLE_SCENE_NORMAL(uv).xyz);\\nfloat
    upDot = saturate(dot(normalWS, float3(0.0, 1.0, 0.0)));\\nfloat upMask = smoothstep(0.34202015,
    0.46202015, upDot);\\nfloat2 snowUV = uv * max(SnowScale, 0.001);\\nfloat3 snowTexture
    = SAMPLE_TEXTURE2D(SnowTexture.tex, SnowTexture.samplerstate, snowUV).rgb;\\nfloat
    snowMask = saturate(upMask * SnowAmount);\\nColor = lerp(sceneColor, snowTexture
    * SnowColor.rgb, snowMask);\\nAlpha = 1.0;\"\r\n}\n\n{\r\n    \"m_SGVersion\": 
    0,\r\n    \"m_Type\":  \"UnityEditor.ShaderGraph.Vector4MaterialSlot\",\r\n   
    \"m_ObjectId\":  \"2c0cdbd4f7e244c8adaa597d5ac338df\",\r\n    \"m_Id\":  0,\r\n   
    \"m_DisplayName\":  \"Screen Position\",\r\n    \"m_SlotType\":  0,\r\n    \"m_Hidden\": 
