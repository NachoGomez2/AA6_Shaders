    },\r\n    \"m_DefaultValue\":  {\r\n                           \"y\":  0,\r\n                          
    \"w\":  0,\r\n                           \"z\":  0,\r\n                          
    \"x\":  0\r\n                       },\r\n    \"m_Labels\":  [\r\n\r\n                
    ]\r\n}\n\n{\r\n    \"m_SGVersion\":  0,\r\n    \"m_Type\":  \"UnityEditor.ShaderGraph.Texture2DInputMaterialSlot\",\r\n   
    \"m_ObjectId\":  \"d9ab2704527e47c0b9d2bd1ad5f25407\",\r\n    \"m_Id\":  1,\r\n   
    \"m_DisplayName\":  \"Snow Texture\",\r\n    \"m_SlotType\":  0,\r\n    \"m_Hidden\": 
