{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "snow_function_node",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SnowSmoothstepMask (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -580.0,
            "y": 210.0,
            "width": 320.0,
            "height": 425.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "cf_scene_color_slot"
        },
        {
            "m_Id": "cf_normal_slot"
        },
        {
            "m_Id": "cf_uv_slot"
        },
        {
            "m_Id": "cf_texture_slot"
        },
        {
            "m_Id": "cf_scale_slot"
        },
        {
            "m_Id": "cf_amount_slot"
        },
        {
            "m_Id": "cf_color_slot"
        },
        {
            "m_Id": "cf_out_slot"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SnowSmoothstepMask",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 screenUV = saturate(UV.xy);\nfloat snowAmount = saturate(SnowAmount);\nfloat rawDepth = SHADERGRAPH_SAMPLE_SCENE_DEPTH(screenUV);\n#if UNITY_REVERSED_Z\nfloat hasGeometry = rawDepth > 0.00001;\n#else\nfloat hasGeometry = rawDepth < 0.99999;\n#endif\nfloat3 positionWS = ComputeWorldSpacePosition(screenUV, rawDepth, UNITY_MATRIX_I_VP);\nfloat3 normalWS = normalize(NormalWS);\nfloat upDot = saturate(dot(normalWS, float3(0.0, 1.0, 0.0)));\nfloat slopeMask = smoothstep(0.3420201433, 0.50, upDot);\nfloat height01 = saturate((positionWS.y + 2.0) / 14.0);\nfloat2 worldUV = positionWS.xz * max(SnowScale, 0.001) * 0.0125;\nfloat largeNoise = SAMPLE_TEXTURE2D(SnowTexture.tex, SnowTexture.samplerstate, worldUV * 0.48 + float2(0.11, 0.37)).r;\nfloat midNoise = SAMPLE_TEXTURE2D(SnowTexture.tex, SnowTexture.samplerstate, worldUV * 1.45 + float2(0.61, 0.19)).r;\nfloat fineNoise = SAMPLE_TEXTURE2D(SnowTexture.tex, SnowTexture.samplerstate, worldUV * 4.65 + float2(0.03, 0.83)).r;\nfloat microNoise = SAMPLE_TEXTURE2D(SnowTexture.tex, SnowTexture.samplerstate, worldUV * 12.0 + float2(0.47, 0.52)).r;\nfloat2 patchCell = floor(positionWS.xz * 0.28);\nfloat cellHash = frac(sin(dot(patchCell, float2(12.9898, 78.233))) * 43758.5453);\nfloat depositNoise = saturate(largeNoise * 0.48 + midNoise * 0.28 + fineNoise * 0.16 + cellHash * 0.08);\nfloat depositPriority = smoothstep(0.12, 0.88, depositNoise);\nfloat elevationDelay = height01 * 0.62;\nfloat patchDelay = lerp(0.31, 0.002, depositPriority);\nfloat localStart = min(elevationDelay + patchDelay, 0.84);\nfloat localWidth = lerp(0.18, 0.11, depositPriority) + (1.0 - slopeMask) * 0.08;\nfloat growth = smoothstep(localStart, localStart + localWidth, snowAmount);\nfloat edgeBand = saturate(1.0 - abs(growth * 2.0 - 1.0));\nfloat textureCoverage = lerp(0.62, 1.0, smoothstep(0.15, 0.95, fineNoise * 0.65 + microNoise * 0.35));\nfloat edgeDust = smoothstep(0.60, 0.95, microNoise) * edgeBand * 0.15;\nfloat amount = saturate((growth * textureCoverage + edgeDust) * slopeMask * hasGeometry);\nfloat3 baseColor = saturate(SceneColor.rgb);\nfloat edgeLift = 0.10 + 0.12 * microNoise + 0.08 * edgeBand;\nfloat3 firstDusting = saturate(baseColor + SnowColor.rgb * edgeLift);\nfloat fullSnowMix = saturate(0.42 + 0.22 * growth + 0.13 * largeNoise);\nfloat3 settledSnow = lerp(firstDusting, SnowColor.rgb, fullSnowMix);\nfloat3 snowedColor = saturate(max(firstDusting, settledSnow));\nOut = saturate(max(baseColor, lerp(baseColor, snowedColor, amount)));"
}

